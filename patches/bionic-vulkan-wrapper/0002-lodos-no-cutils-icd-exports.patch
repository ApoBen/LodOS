diff --git a/src/android_stub/cutils_local.c b/src/android_stub/cutils_local.c
new file mode 100644
index 0000000..a5013b4
--- /dev/null
+++ b/src/android_stub/cutils_local.c
@@ -0,0 +1,34 @@
+/* LodOS: local static replacement for the few libcutils symbols mesa uses,
+ * so the wrapper .so has no libcutils.so (non-NDK) DT_NEEDED. */
+#include <stdint.h>
+#include <string.h>
+#include <sys/system_properties.h>
+
+int property_get(const char *key, char *value, const char *default_value);
+uint64_t atrace_get_enabled_tags(void);
+void atrace_init(void);
+void atrace_begin_body(const char *name);
+void atrace_end_body(void);
+
+int property_get(const char *key, char *value, const char *default_value)
+{
+   int len = __system_property_get(key, value);
+   if (len > 0)
+      return len;
+   if (default_value) {
+      len = (int)strlen(default_value);
+      if (len >= PROP_VALUE_MAX)
+         len = PROP_VALUE_MAX - 1;
+      memcpy(value, default_value, len);
+      value[len] = '\0';
+      return len;
+   }
+   value[0] = '\0';
+   return 0;
+}
+
+/* tracing disabled: no tags enabled -> begin/end never called by inline helpers */
+uint64_t atrace_get_enabled_tags(void) { return 0; }
+void atrace_init(void) {}
+void atrace_begin_body(const char *name) { (void)name; }
+void atrace_end_body(void) {}
