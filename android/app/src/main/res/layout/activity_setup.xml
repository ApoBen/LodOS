<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/setup_step_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#90CAF9"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/setup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/setup_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#CCCCCC"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/setup_rootfs_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/setup_rootfs_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/setup_rootfs_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/setup_rootfs_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#EF9A9A"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setup_start_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/setup_session_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Session: Stopped"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/setup_btn_allow_sdcard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow /sdcard" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_btn_session_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start session" />

            <Button
                android:id="@+id/setup_btn_session_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Stop session" />
        </LinearLayout>

        <Button
            android:id="@+id/setup_btn_native_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_btn_native_info" />

        <Button
            android:id="@+id/setup_btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/setup_btn_report"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/setup_btn_report" />

        <Button
            android:id="@+id/setup_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/setup_btn_back" />

        <Button
            android:id="@+id/setup_btn_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_btn_continue" />
    </LinearLayout>

</LinearLayout>
